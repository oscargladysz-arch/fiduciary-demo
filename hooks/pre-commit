#!/bin/sh
# Tark gate. Every commit must pass the FULL suite set. Never weaken.
# Install: cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# activate the venv when there is one (dash exits on a failed dot-source,
# which is what a CI runner without a venv would hit)
[ -f .venv/bin/activate ] && . .venv/bin/activate
python src/validate_data.py && \
python src/validate_census.py && \
python src/test_evidence_immutable.py && \
python src/corrections_log.py check && \
python src/test_invariants.py && \
python src/test_copy.py && \
python src/test_docs.py && \
python src/test_analytics.py && \
python src/test_cohort.py && \
python src/test_benchmark.py && \
python src/test_liquidity.py && \
python src/test_ingest.py && \
python app/test_workspace.py && \
python worker/test_worker.py && \
python src/test_memo.py && \
python src/test_app.py && \
python src/test_artifacts_fresh.py && \
python src/build_site.py && \
python src/reconcile.py && \
python src/test_surfaces.py && \
python src/test_web.py && \
python src/test_frontend.py && \
python src/assemble_site.py
